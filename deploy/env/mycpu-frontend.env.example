# Remote my_visual_CPU frontend/debug-server environment.
# Copy to deploy/env/mycpu-frontend.env on the remote checkout before enabling
# deploy/systemd/mycpu-frontend.service.

NODE_ENV=production

# The Node debug server defaults to 127.0.0.1 and only accepts --port.
MYCPU_FRONTEND_PORT=4173

# Remote runtime asset contract. Do not replace these with fake placeholder
# files; missing assets should remain a visible fail-closed diagnostic.
MYCPU_LINUX_PROTO_CONSOLE_IMAGE=/srv/apps/my_visual_CPU/runtime-assets/linux/Image
MYCPU_LINUX_PROTO_RUNTIME_IMAGE=/srv/apps/my_visual_CPU/runtime-assets/linux/Image
SPIKE_PATH=/srv/apps/my_visual_CPU/runtime-assets/spike/bin/spike
MYCPU_RUNTIME_TMPDIR=/srv/apps/my_visual_CPU/tmp
MYCPU_AUDIT_LOG_PATH=/srv/apps/my_visual_CPU/logs/audit.log

# Minimal remote auth layer.
# Generate a password hash before enabling auth on a live service.
# Example:
# node -e "const crypto=require('crypto'); const p='change-me'; const N=16384,r=8,p2=1; const s=crypto.randomBytes(16); const h=crypto.scryptSync(p,s,64,{N,r,p:p2}); console.log(['scrypt',N,r,p2,s.toString('base64url'),h.toString('base64url')].join('$'));"
MYCPU_AUTH_ENABLED=1
MYCPU_AUTH_ADMIN_USERNAME=admin
MYCPU_AUTH_ADMIN_PASSWORD_HASH=
MYCPU_AUTH_SESSION_LIMIT=3
MYCPU_AUTH_SECURE_COOKIES=1

# Opt-in only. Leave unset in the long-running service unless explicitly
# validating a real Linux console route on the remote host.
# MYCPU_RUN_LINUX_PROTO_CONSOLE_E2E=1
